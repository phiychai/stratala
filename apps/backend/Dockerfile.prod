FROM node:26-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Builder stage
FROM base AS builder
WORKDIR /app

# Copy workspace configuration
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY turbo.json ./

# Copy packages
COPY packages ./packages

# Copy backend app
COPY apps/backend ./apps/backend

# Payload Local API is loaded from the Studio TypeScript config at runtime.
COPY apps/studio ./apps/studio

# Install dependencies and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter backend build

# Production stage
FROM base AS production
WORKDIR /app

# Copy workspace configuration
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy packages
COPY packages ./packages

# Keep the Studio config and its collection modules available to the backend
# Local API without relying on a runtime repository bind mount.
COPY --from=builder /app/apps/studio/src ./apps/studio/src
COPY --from=builder /app/apps/studio/package.json ./apps/studio/package.json

# Copy built backend
COPY --from=builder /app/apps/backend/build ./apps/backend

# The backend dynamically loads Payload's TypeScript config (via jiti/tsx), so
# retain the deterministic workspace install produced by the builder instead
# of reinstalling only backend production dependencies.
COPY --from=builder /app/node_modules ./node_modules

WORKDIR /app/apps/backend

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
RUN chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 3333

CMD ["node", "bin/server.js"]

{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "pnpm --filter @stratala/shared-types build && node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#utils/*": "./app/utils/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./types/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@stratala/eslint-config": "workspace:*",
    "@swc/core": "1.15.33",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/zxcvbn": "^4.4.5",
    "eslint": "^10.4.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.3",
    "ts-node-maintained": "^10.9.5",
    "tsx": "^4.22.3",
    "typescript": "~6.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@stratala/shared-types": "workspace:*",
    "@vinejs/vine": "^4.4.0",
    "adonis-autoswagger": "^3.73.0",
    "better-auth": "^1.6.11",
    "better-call": "^1.3.5",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.10.1",
    "luxon": "^3.7.2",
    "payload": "^3.84.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "zxcvbn": "^4.4.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "./prettier.config.cjs"
}
